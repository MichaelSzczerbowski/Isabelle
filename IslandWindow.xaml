<Window x:Class="IslandPlayer.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IslandPlayer"
        Title="Isabelle"
        Width="520" Height="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <!-- przycisk z samą ikoną (bez ramek Windows) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.88" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- mały "chip" (aplikacja, tekst piosenki) -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="8,2,8,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Width="520" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <!-- cień pod wyspą -->
        <Border x:Name="Shadow" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                Background="Black" Opacity="0" IsHitTestVisible="False" Width="44" Height="30" CornerRadius="15">
            <Border.Effect>
                <BlurEffect Radius="28" RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <!-- poświata w kolorze okładki -->
        <Border x:Name="Glow" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Background="#1ED760" Opacity="0" IsHitTestVisible="False" Width="44" Height="30" CornerRadius="15">
            <Border.Effect>
                <BlurEffect Radius="26" RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <!-- sama wyspa -->
        <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Background="Black" Width="44" Height="30" CornerRadius="15">
            <Grid x:Name="PillInner" ClipToBounds="True">

                <!-- rozmyta okładka w tle (jak w Apple Music).
                     W Canvas, bo zwykła siatka przycinała duży obrazek do rozmiaru wyspy,
                     a przy obracaniu było widać rogi tego przyciętego prostokąta. -->
                <Canvas x:Name="BgHost" IsHitTestVisible="False">
                    <Image x:Name="BgCover" Stretch="UniformToFill" Width="720" Height="720" Opacity="0" IsHitTestVisible="False">
                        <Image.Effect>
                            <BlurEffect Radius="70" RenderingBias="Performance" />
                        </Image.Effect>
                    </Image>
                    <Image x:Name="BgCover2" Stretch="UniformToFill" Width="720" Height="720" Opacity="0" IsHitTestVisible="False">
                        <Image.Effect>
                            <BlurEffect Radius="80" RenderingBias="Performance" />
                        </Image.Effect>
                    </Image>
                </Canvas>
                <Border x:Name="BgDim" Background="#A0000000" Opacity="0" IsHitTestVisible="False" />

                <!-- spoczynek: kropka / zegar -->
                <Grid x:Name="IdleView" Height="30" VerticalAlignment="Top" HorizontalAlignment="Stretch" IsHitTestVisible="False">
                    <Ellipse x:Name="IdleDot" Width="7" Height="7" HorizontalAlignment="Right" Margin="0,0,12,0"
                             Fill="#1E1E26" Stroke="#30303A" StrokeThickness="1" />
                    <TextBlock x:Name="IdleClock" Text="12:00" Foreground="White" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- mała wyspa: okładka + słupki -->
                <Grid x:Name="CompactView" Width="180" Height="32" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
                    <Grid Width="20" Height="20" HorizontalAlignment="Left" Margin="7,0,0,0">
                        <Border CornerRadius="6" Background="#2A2A30" />
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush x:Name="CompactArtBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <Canvas x:Name="CompactTitleClip" ClipToBounds="True" Height="18" Margin="36,0,38,1" VerticalAlignment="Center"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="CompactTitleText" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </Canvas>
                    <local:BarsControl x:Name="CompactBars" Width="17" Height="14" HorizontalAlignment="Right" Margin="0,0,12,0" />
                </Grid>

                <!-- powiadomienie o nowym utworze -->
                <Grid x:Name="ToastView" Width="330" Height="76" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="50" Height="50" Margin="13,0,0,0">
                        <Border CornerRadius="12" Background="#2A2A30" />
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush x:Name="ToastArtBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastLabel" Text="TERAZ GRA" FontSize="9.5" FontWeight="Bold" Foreground="#1ED760" />
                        <TextBlock x:Name="ToastTitle" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        <TextBlock x:Name="ToastArtist" FontSize="12" Foreground="#A6FFFFFF" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <local:BarsControl x:Name="ToastBars" Grid.Column="2" Width="18" Height="15" Margin="0,0,20,0" />
                </Grid>

                <!-- głośność -->
                <Grid x:Name="VolView" Width="240" Height="36" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="VolIcon" Width="16" Height="14" Stretch="Uniform" Margin="16,0,10,0" Fill="White"
                          Data="M0,5 H4 L9,0 V16 L4,11 H0 Z" />
                    <Grid Grid.Column="1" Height="5" VerticalAlignment="Center">
                        <Border CornerRadius="2.5" Background="#33FFFFFF" />
                        <Border x:Name="VolFill" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <TextBlock x:Name="VolText" Grid.Column="2" Text="50" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- tryb kropki: świecąca kropka w kolorze okładki -->
                <Grid x:Name="DotView" Opacity="0" IsHitTestVisible="False">
                    <Ellipse x:Name="DotLight" Width="10" Height="10" Fill="#5A5A64" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <!-- animacja startowa: wyspa "wyskakuje" z logo -->
                <Grid x:Name="StartupView" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:BarsControl x:Name="StartupBars" Width="18" Height="16" Fill="#FF5CA0" />
                        <TextBlock x:Name="StartupText" Text="Isabelle" FontSize="16" FontFamily="Segoe Script" Foreground="White"
                                   Margin="10,0,0,1" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ===== PIONOWO (lewa / prawa krawędź ekranu) ===== -->
                <Grid x:Name="IdleVView" Width="30" VerticalAlignment="Stretch" HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0">
                    <Ellipse x:Name="IdleVDot" Width="7" Height="7" VerticalAlignment="Bottom" Margin="0,0,0,12"
                             Fill="#1E1E26" Stroke="#30303A" StrokeThickness="1" />
                    <TextBlock x:Name="IdleVClock" Text="12" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="14" LineStackingStrategy="BlockLineHeight" />
                </Grid>

                <Grid x:Name="CompactVView" Width="32" Height="150" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
                    <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,7,0,0">
                        <Border CornerRadius="6" Background="#2A2A30" />
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush x:Name="CompactVArtBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <local:BarsControl x:Name="CompactVBars" Width="16" Height="14" VerticalAlignment="Bottom" Margin="0,0,0,11" />
                </Grid>

                <StackPanel x:Name="ToastVView" Width="150" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
                    <Grid Width="64" Height="64" Margin="0,16,0,0">
                        <Border CornerRadius="14" Background="#2A2A30" />
                        <Border CornerRadius="14">
                            <Border.Background>
                                <ImageBrush x:Name="ToastVArtBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ToastVLabel" Text="TERAZ GRA" FontSize="9" FontWeight="Bold" Foreground="#1ED760"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock x:Name="ToastVTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" MaxWidth="126" Margin="0,2,0,0" />
                    <TextBlock x:Name="ToastVArtist" FontSize="11.5" Foreground="#A6FFFFFF" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" MaxWidth="126" />
                </StackPanel>

                <Grid x:Name="VolVView" Width="36" Height="220" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0"
                      IsHitTestVisible="False">
                    <Path x:Name="VolVIcon" Width="14" Height="13" Stretch="Uniform" VerticalAlignment="Top" Margin="0,15,0,0" Fill="White"
                          Data="M0,5 H4 L9,0 V16 L4,11 H0 Z" />
                    <Grid Width="5" Height="140" VerticalAlignment="Center">
                        <Border CornerRadius="2.5" Background="#33FFFFFF" />
                        <Border x:Name="VolVFill" CornerRadius="2.5" Background="White" VerticalAlignment="Bottom" Height="0" />
                    </Grid>
                    <TextBlock x:Name="VolVText" Text="50" FontSize="11" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,13" />
                </Grid>

                <!-- nic nie gra (po najechaniu) -->
                <Grid x:Name="IdleExpandedView" Width="300" Height="96" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
                    <StackPanel x:Name="IdleTexts" VerticalAlignment="Center" Margin="22,0,0,0" HorizontalAlignment="Left">
                        <TextBlock x:Name="IdleTitle" Text="Nic nie gra" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="IdleSub" Text="Włącz muzykę w dowolnej aplikacji" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="OpenSpotifyBtn" Style="{StaticResource ChipButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,20,0" Background="#1ED760" Foreground="Black"
                            Content="Spotify" />
                </Grid>

                <!-- pełny odtwarzacz -->
                <StackPanel x:Name="ExpandedView" Width="370" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0">
                    <Grid x:Name="Header" Margin="18,18,18,0" Height="52">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="ArtHost" Width="52" Height="52" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ArtScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="ArtBg" CornerRadius="12" Background="#2A2A30" />
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="#55FFFFFF"
                                  Data="M6,0 L16,-2 V11 A3,3 0 1 1 14,8.2 V2 L8,3.2 V13 A3,3 0 1 1 6,10.2 Z" />
                            <Border x:Name="ArtImg" CornerRadius="12">
                                <Border.Background>
                                    <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel x:Name="InfoPanel" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <Canvas x:Name="TitleClip" ClipToBounds="True" Height="22" IsHitTestVisible="False">
                                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                            </Canvas>
                            <TextBlock x:Name="ArtistText" FontSize="12.5" Foreground="#B3FFFFFF"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="SidePanel" Grid.Column="2" VerticalAlignment="Center">
                            <local:BarsControl x:Name="ExpBars" Width="20" Height="16" HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                                <Button x:Name="LyricsBtn" Style="{StaticResource ChipButton}" ToolTip="Tekst piosenki">
                                    <Path Width="11" Height="10" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M0,0 H12 V2 H0 Z M0,4 H12 V6 H0 Z M0,8 H8 V10 H0 Z" />
                                </Button>
                                <Button x:Name="AppBtn" Style="{StaticResource ChipButton}" Margin="5,0,0,0" ToolTip="Przełącz odtwarzacz">
                                    <TextBlock x:Name="AppText" Text="Spotify" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- tekst piosenki -->
                    <Grid x:Name="LyricsPanel" Height="84" Margin="18,12,18,0" ClipToBounds="True" Visibility="Collapsed" Background="Transparent">
                        <Grid.OpacityMask>
                            <!-- Absolute: maska liczona od wysokości panelu, a nie od całego (długiego) tekstu -->
                            <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,84">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#FF000000" Offset="0.2" />
                                <GradientStop Color="#FF000000" Offset="0.8" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.OpacityMask>
                        <Canvas>
                            <StackPanel x:Name="LyricsStack" Width="334">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="LyricsShift" />
                                </StackPanel.RenderTransform>
                            </StackPanel>
                        </Canvas>
                    </Grid>

                    <!-- pasek postępu -->
                    <Grid x:Name="SeekArea" Height="14" Margin="18,14,18,0" Background="Transparent" Cursor="Hand">
                        <Border x:Name="TrackBg" Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center" />
                        <Border x:Name="TrackFill" Height="4" CornerRadius="2" Background="White" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Width="0" />
                        <Ellipse x:Name="Thumb" Width="11" Height="11" Fill="White" HorizontalAlignment="Left"
                                 VerticalAlignment="Center" Opacity="0" />
                    </Grid>
                    <Grid Margin="18,1,18,0">
                        <TextBlock x:Name="PosText" Text="0:00" FontSize="10.5" Foreground="#8CFFFFFF" HorizontalAlignment="Left" />
                        <TextBlock x:Name="DurText" Text="0:00" FontSize="10.5" Foreground="#8CFFFFFF" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- sterowanie -->
                    <Grid Margin="18,0,18,14" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PrevBtn" Grid.Column="1" Style="{StaticResource IconButton}" Width="44" Height="44">
                            <Path Width="15" Height="15" Stretch="Uniform" Fill="White"
                                  Data="M0,0 H2.4 V14 H0 Z M14,0 V14 L3.4,7 Z" />
                        </Button>
                        <Button x:Name="PlayBtn" Grid.Column="2" Style="{StaticResource IconButton}" Width="44" Height="44" Opacity="1">
                            <Grid Width="40" Height="40">
                                <Ellipse Fill="White" />
                                <Path x:Name="PlayIcon" Width="14" Height="15" Stretch="Uniform" Fill="Black" Margin="2,0,0,0"
                                      Data="M0,0 L12,7 L0,14 Z" />
                                <Path x:Name="PauseIcon" Width="12" Height="14" Stretch="Uniform" Fill="Black"
                                      Data="M0,0 H4 V14 H0 Z M8,0 H12 V14 H8 Z" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button x:Name="NextBtn" Grid.Column="3" Style="{StaticResource IconButton}" Width="44" Height="44">
                            <Path Width="15" Height="15" Stretch="Uniform" Fill="White"
                                  Data="M0,0 L10.6,7 L0,14 Z M11.6,0 H14 V14 H11.6 Z" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
